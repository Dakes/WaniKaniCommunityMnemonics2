{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
//    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "typeRoots": [
      "./types",
      "./node_modules/@types",
      "./typings.d.ts"
    ],
    "lib": [
      "esnext",
      "ES2022.String",
      "dom"
    ]
  },
  "include": [
    "src/**/*",
    "src/**/*.svelte"
  ],
  "exclude": [
    "node_modules"
  ]
}
